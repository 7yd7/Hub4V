ed) local targets = {}; if isAllSelected(selected) then for _, obj in ipairs(folder:GetChildren()) do if obj:IsA(\\u0027Model\\u0027) or obj:IsA(\\u0027BasePart\\u0027) then table.insert(targets, obj) end end else for name, enabled in pairs(selected) do if enabled and name ~= \\u0027All\\u0027 then local target = folder:FindFirstChild(name); if target then table.insert(targets, target) end end end end; return targets end; local lp = game.Players.LocalPlayer; local function checkConditions() local char = lp.Character; local root = char and char:FindFirstChild(\\u0027HumanoidRootPart\\u0027); if not root then return end; local zone = workspace:FindFirstChild(\\u0027InvisWalls\\u0027) and workspace.InvisWalls:FindFirstChild(\\u0027DeliveryZone\\u0027); if zone and zone:FindFirstChild(\\u0027TouchInterest\\u0027) then local hasModel = false; for _, v in ipairs(char:GetChildren()) do if v:IsA(\\u0027Model\\u0027) then hasModel = true; break end end; if hasModel then firetouchinterest(root, zone, 0); task.wait(); firetouchinterest(root, zone, 1) end end; for _, t in ipairs(char:GetChildren()) do if t:IsA(\\u0027Tool\\u0027) and not isPickaxe(t) then t.Parent = lp.Backpack end end; if not char:FindFirstChildWhichIsA(\\u0027Tool\\u0027) then for _, t in ipairs(lp.Backpack:GetChildren()) do if isPickaxe(t) then t.Parent = char; break end end end; local eq = char:FindFirstChildOfClass(\\u0027Tool\\u0027); if eq and isPickaxe(eq) then eq:Activate() end end; local function collectBrainrots() local container = workspace:FindFirstChild(\\u0027Brainrots\\u0027); local root = lp.Character and lp.Character:FindFirstChild(\\u0027HumanoidRootPart\\u0027); if not container or not root then return end; task.wait(0.2); local items = container:GetChildren(); table.sort(items, function(a, b) local ap = a:GetPivot().Position; local bp = b:GetPivot().Position; return (root.Position - ap).Magnitude \\u003c (root.Position - bp).Magnitude end); for _, item in ipairs(items) do if not getgenv().AutoFarmBlocks then break end; if item.Parent == container then while getgenv().AutoFarmBlocks and item.Parent == container do root.CFrame = item:GetPivot(); checkConditions(); local prompt = (item:FindFirstChild(\\u0027Mesh\\u0027) and item.Mesh:FindFirstChild(\\u0027PickupPrompt\\u0027)) or item:FindFirstChild(\\u0027PickupPrompt\\u0027, true); if prompt and prompt:IsA(\\u0027ProximityPrompt\\u0027) then fireproximityprompt(prompt) end; task.wait(0.05) end end end end; Value:AddDropdown(\\u0027BlockType\\u0027, {Title = \\u0027Select Block Type\\u0027, Values = blockNames, Default = {\\u0027All\\u0027}, Multi = true, Callback = function(V) getgenv().TargetBlockTypes = normalizeSelection(V) end}); Value:AddToggle(\\u0027AutoFarmBlocks\\u0027, {Title = \\u0027Start Auto Farm\\u0027, Default = false, Callback = function(V) getgenv().AutoFarmBlocks = V; if V then task.spawn(function() local remotes = game:GetService(\\u0027ReplicatedStorage\\u0027):FindFirstChild(\\u0027Remotes\\u0027); local remote = remotes and remotes:FindFirstChild(\\u0027DamageBlockEvent\\u0027); while getgenv().AutoFarmBlocks do local folder = workspace:FindFirstChild(\\u0027LuckyBlocks\\u0027); if folder then local selected = normalizeSelection(getgenv().TargetBlockTypes); local targets = collectTargets(folder, selected); for _, target in ipairs(targets) do if not getgenv().AutoFarmBlocks then break end; while getgenv().AutoFarmBlocks and target.Parent == folder do checkConditions(); local root = lp.Character and lp.Character:FindFirstChild(\\u0027HumanoidRootPart\\u0027); if root then root.CFrame = target:GetPivot() end; if remote then remote:FireServer(target) end; task.wait(0.05) end; collectBrainrots() end end; task.wait(0.1) end end) end end})\"\n                },\n                {\n                    \"Type\": \"Section\",\n                    \"Title\":  \"More\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"Script\": \"getgenv(