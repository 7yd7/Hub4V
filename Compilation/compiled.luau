getgenv().NEXS_PACKAGE["Script/Games/PushRockForBrainrots.json"] = "{\n    \"Tabs\": [\n        {\n            \"Title\": \"Auto Matic\",\n            \"SectionTitle\": \"Auto Farm\",\n            \"Elements\": [\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Brainrots\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"Script\": \"local Players = game:GetService('Players')\\nlocal lp = Players.LocalPlayer\\n\\ngetgenv().PRFB_SelectedRarity = {[ 'All' ] = true}\\ngetgenv().PRFB_SelectedBrainrots = {[ 'All' ] = true}\\ngetgenv().PRFB_AutoTake = false\\n\\nlocal function getNormalFolder()\\n    local gui = lp:FindFirstChild('PlayerGui')\\n    local menus = gui and gui:FindFirstChild('Menus')\\n    local index = menus and menus:FindFirstChild('Index')\\n    local mainFrame = index and index:FindFirstChild('MainFrame')\\n    local mainBar = mainFrame and mainFrame:FindFirstChild('MainBar')\\n    return mainBar and mainBar:FindFirstChild('Normal')\\nend\\n\\nlocal function trim(s)\\n    s = tostring(s or '')\\n    return (s:gsub('^%\\\\s*(.-)%\\\\s*$', '%1'))\\nend\\n\\nlocal function normalizeSelection(v)\\n    local selected = {}\\n    if type(v) == 'string' then\\n        selected[v] = true\\n    elseif type(v) == 'table' then\\n        if #v > 0 then\\n            for _, name in ipairs(v) do\\n                if type(name) == 'string' then\\n                    selected[name] = true\\n                end\\n            end\\n        else\\n            for name, enabled in pairs(v) do\\n                if enabled then\\n                    selected[name] = true\\n                end\\n            end\\n        end\\n    end\\n\\n    local hasNonAll = false\\n    for name, enabled in pairs(selected) do\\n        if enabled and name ~= 'All' then\\n            hasNonAll = true\\n            break\\n        end\\n    end\\n\\n    if hasNonAll then\\n        selected['All'] = nil\\n    end\\n\\n    if next(selected) == nil then\\n        selected['All'] = true\\n    end\\n\\n    return selected\\nend\\n\\nlocal function isAllSelected(selected)\\n    selected = selected or {}\\n    for name, enabled in pairs(selected) do\\n        if enabled and name ~= 'All' then\\n            return false\\n        end\\n    end\\n    return selected['All'] == true or next(selected) == nil\\nend\\n\\nlocal function getButtonRarity(button)\\n    local rarity = button:FindFirstChild('IndexRarity')\\n    if rarity and (rarity:IsA('TextLabel') or rarity:IsA('TextBox')) then\\n        return trim(rarity.Text)\\n    end\\n    return ''\\nend\\n\\nlocal function buildIndexMap()\\n    local map = {}\\n    local normal = getNormalFolder()\\n    if not normal then\\n        return map\\n    end\\n\\n    for _, child in ipairs(normal:GetChildren()) do\\n        if child:IsA('ImageButton') then\\n            local name = trim(child.Name)\\n            if name ~= '' then\\n                map[name] = {\\n                    rarity = getButtonRarity(child)\\n                }\\n            end\\n        end\\n    end\\n\\n    return map\\nend\\n\\nlocal function raritySelected(rarity)\\n    local selected = getgenv().PRFB_SelectedRarity or {[ 'All' ] = true}\\n    if isAllSelected(selected) then\\n        return true\\n    end\\n\\n    rarity = string.lower(trim(rarity))\\n    if rarity == '' then\\n        return false\\n    end\\n\\n    for name, enabled in pairs(selected) do\\n        if enabled and name ~= 'All' and string.lower(trim(name)) == rarity then\\n            return true\\n        end\\n    end\\n\\n    return false\\nend\\n\\nlocal function getRarityValues()\\n    local values = {'All'}\\n    local seen = {['All'] = true}\\n    local normal = getNormalFolder()\\n    if not normal then\\n        return values\\n    end\\n\\n    for _, child in ipairs(normal:GetChildren()) do\\n        if child:IsA('ImageButton') then\\n            local rarity = getButtonRarity(child)\\n            if rarity ~= '' and not seen[rarity] then\\n                seen[rarity] = true\\n                table.insert(values, rarity)\\n            end\\n        end\\n    end\\n\\n    return values\\nend\\n\\nlocal function getBrainrotValues(selectedRarity)\\n    local values = {'All'}\\n    local seen = {['All'] = true}\\n    local normal = getNormalFolder()\\n    if not normal then\\n        return values\\n    end\\n\\n    local selected = selectedRarity or {[ 'All' ] = true}\\n\\n    for _, child in ipairs(normal:GetChildren()) do\\n        if child:IsA('ImageButton') then\\n            local rarity = getButtonRarity(child)\\n            if isAllSelected(selected) or raritySelected(rarity) then\\n                local name = trim(child.Name)\\n                if name ~= '' and not seen[name] then\\n                    seen[name] = true\\n                    table.insert(values, name)\\n                end\\n            end\\n        end\\n    end\\n\\n    return values\\nend\\n\\nlocal function brainrotMatches(name)\\n    local selected = getgenv().PRFB_SelectedBrainrots or {[ 'All' ] = true}\\n    if isAllSelected(selected) then\\n        return true\\n    end\\n\\n    local n = string.lower(trim(name))\\n\\n    for sel, enabled in pairs(selected) do\\n        if enabled and sel ~= 'All' then\\n            local s = string.lower(trim(sel))\\n            if s == n then\\n                return true\\n            end\\n            if n:find(s, 1, true) then\\n                return true\\n            end\\n            if s:find(n, 1, true) then\\n                return true\\n            end\\n        end\\n    end\\n\\n    return false\\nend\\n\\nlocal brainrotDropdown\\nlocal prfb_updatingBrainrots = false\\n\\nbrainrotDropdown = Value:AddDropdown('PRFB_Brainrots', {\\n    Title = 'Select Brainrots',\\n    Values = getBrainrotValues({['All'] = true}),\\n    Default = {'All'},\\n    Multi = true,\\n    Callback = function(v)\\n        if prfb_updatingBrainrots then\\n            return\\n        end\\n        getgenv().PRFB_SelectedBrainrots = normalizeSelection(v)\\n    end\\n})\\n\\nlocal function getRoot()\\n    local char = lp.Character\\n    return char and char:FindFirstChild('HumanoidRootPart')\\nend\\n\\nlocal function getFinishPart()\\n    local zones = workspace:FindFirstChild('Zones')\\n    return zones and zones:FindFirstChild('FinishPart')\\nend\\n\\nlocal function touchFinishIfCarrying()\\n    if lp:GetAttribute('isCarrying') ~= true then\\n        return false\\n    end\\n\\n    local root = getRoot()\\n    local finish = getFinishPart()\\n    if root and finish and finish:FindFirstChild('TouchInterest') then\\n        firetouchinterest(root, finish, 0)\\n        task.wait()\\n        firetouchinterest(root, finish, 1)\\n    end\\n\\n    return true\\nend\\n\\nlocal function findTargetInZones()\\n    local zones = workspace:FindFirstChild('Zones')\\n    if not zones then\\n        return nil\\n    end\\n\\n    local indexMap = buildIndexMap()\\n\\n    for _, zone in ipairs(zones:GetChildren()) do\\n        if zone.Name:match('^Zone') then\\n            for _, candidate in ipairs(zone:GetChildren()) do\\n                if candidate:IsA('Model') then\\n                    local stand = candidate:FindFirstChild('StandPrimary')\\n                    local prompt = stand and stand:FindFirstChild('CollectPrompt')\\n                    if stand and prompt and prompt:IsA('ProximityPrompt') then\\n                        if not stand:FindFirstChild('CarryWeld') then\\n                            local info = indexMap[trim(candidate.Name)]\\n                            local rarityOk = info and raritySelected(info.rarity)\\n                            if rarityOk and brainrotMatches(candidate.Name) then\\n                                return candidate\\n                            end\\n                        end\\n                    end\\n                end\\n            end\\n        end\\n    end\\n\\n    return nil\\nend\\n\\nlocal function teleportToTarget(target)\\n    local root = getRoot()\\n    if not root or not target then\\n        return\\n    end\\n\\n    local stand = target:FindFirstChild('StandPrimary')\\n    if not stand then\\n        return\\n    end\\n\\n    root.CFrame = stand.CFrame + Vector3.new(0, 2, 0)\\n\\n    local prompt = stand:FindFirstChild('CollectPrompt')\\n    if prompt and prompt:IsA('ProximityPrompt') then\\n        fireproximityprompt(prompt)\\n    end\\nend\\n\\nValue:AddToggle('PRFB_AutoTake', {\\n    Title = 'Auto Take',\\n    Default = false,\\n    Callback = function(v)\\n        getgenv().PRFB_AutoTake = v\\n        if v then\\n            task.spawn(function()\\n                while getgenv().PRFB_AutoTake do\\n                    pcall(function()\\n                        if touchFinishIfCarrying() then\\n                            return\\n                        end\\n\\n                        local target = findTargetInZones()\\n                        if target and target.Parent then\\n                            while getgenv().PRFB_AutoTake and target.Parent do\\n                                if touchFinishIfCarrying() then\\n                                    break\\n                                end\\n\\n                                local stand = target:FindFirstChild('StandPrimary')\\n                                if not stand or stand:FindFirstChild('CarryWeld') then\\n                                    break\\n                                end\\n\\n                                teleportToTarget(target)\\n                                task.wait(0.1)\\n                            end\\n                        end\\n                    end)\\n                    task.wait(0.1)\\n                end\\n            end)\\n        end\\n    end\\n})\"\n                }\n            ]\n        }\n    ]\n}\n\n"
