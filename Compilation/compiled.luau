e:AddDropdown('ItemSelector', {Title = 'Select Items', Values = getFilteredItems(), Default = {'All'}, Multi = true, Callback = function(V) getgenv().SelectedItemNames = V end}); local function isItemSelected(name) if not name or name == '' then return false end; local selected = getgenv().SelectedItemNames; if not selected then return false end; if type(selected) == 'string' then return selected == 'All' or selected == name end; local hasSpecific = false; local foundMatch = false; for k, v in pairs(selected) do local val = (type(k) == 'number' and v or k); if val ~= 'All' then hasSpecific = true end; if val == name or (type(v) == 'boolean' and v and k == name) then foundMatch = true end end; if hasSpecific then return foundMatch end; for _, v in pairs(selected) do if v == 'All' then return true end end; return false end; local function getChar() return lp.Character or lp.CharacterAdded:Wait() end; local function getRoot() local c = getChar(); return c and c:FindFirstChild('HumanoidRootPart') end; local function isInsideZone(zonePart) local root = getRoot(); if not root or not zonePart then return false end; local pos = root.Position; local cf = zonePart.CFrame; local size = zonePart.Size / 2; local rel = cf:PointToObjectSpace(pos); return math.abs(rel.X) <= size.X and math.abs(rel.Y) <= size.Y and math.abs(rel.Z) <= size.Z end; local function teleportToZone(zoneName) local zonesF = workspace:FindFirstChild('Zones'); if not zonesF then return nil end; local zone = zonesF:FindFirstChild(zoneName); if not zone then return nil end; local hitbox = zone:FindFirstChildWhichIsA('BasePart') or zone; local root = getRoot(); if root then root.CFrame = hitbox.CFrame; task.wait(0.3); if not isInsideZone(hitbox) then root.CFrame = hitbox.CFrame; task.wait(0.2) end end; return zone end; Value:AddToggle('AutoFarmToggle', {Title = 'Auto Farm', Default = false, Callback = function(V) getgenv().AutoFarmEnabled = V; if V then task.spawn(function() local depositPos = Vector3.new(7, 18, -480); while getgenv().AutoFarmEnabled do pcall(function() local selectedZone = getgenv().SelectedZone; local zonesToCheck = {}; if selectedZone == 'All' then local zf = workspace:FindFirstChild('Zones'); if zf then for _, z in ipairs(zf:GetChildren()) do table.insert(zonesToCheck, z.Name) end end else table.insert(zonesToCheck, selectedZone) end; for _, zoneName in ipairs(zonesToCheck) do if not getgenv().AutoFarmEnabled then break end; teleportToZone(zoneName); local spawners = workspace:FindFirstChild('ItemSpawners'); if not spawners then continue end; local zoneSpawner = spawners:FindFirstChild(zoneName); if not zoneSpawner then task.wait(0.5); teleportToZone(zoneName); continue end; local foundItem = false; for _, spawner in ipairs(zoneSpawner:GetChildren()) do if not getgenv().AutoFarmEnabled then break end; local origName = spawner:GetAttribute('OriginalName') or spawner.Name; if not isItemSelected(origName) then continue end; foundItem = true; local itemPart = nil; local prompt = nil; local rp = spawner:FindFirstChild('RootPart'); if rp then prompt = rp:FindFirstChild('ProximityPrompt'); itemPart = rp end; if not prompt then for _, desc in ipairs(spawner:GetDescendants()) do if desc:IsA('ProximityPrompt') then prompt = desc; itemPart = desc.Parent; break end end end; if not prompt or not itemPart then continue end; local root = getRoot(); if not root then break end; root.CFrame = itemPart.CFrame; task.wait(0.3); local attempts = 0; while getgenv().AutoFarmEnabled and attempts < 20 do root = getRoot(); if not root then break end; root.CFrame = itemPart.CFrame; fireproximityprompt(prompt); task.wait(0.2); local playerFolder = workspace:FindFirstChild(lp.Name); local carry = playerFolder and playerFolder:FindFirstChild('CarryVisuals'); if carry and #carry:GetChildren() > 0 then break end; attempts = attempts + 1 end; local playerFolder = workspace:FindFirstChild(lp.Name); local carry = playerFolder and playerFolder:FindFirstChild('CarryVisuals'); if carry and #carry:GetChildren() > 0 then local carryCount = #carry:GetChildren(); local maxCarry = lp:GetAttribute('MaxCarry') or 1; if carryCount >= maxCarry then root = getRoot(); if root then root.CFrame = CFrame.new(depositPos); repeat task.wait(0.2); if not getgenv().AutoFarmEnabled then break end; playerFolder = workspace:FindFirstChild(lp.Name); carry = playerFolder and playerFolder:FindFirstChild('CarryVisuals'); until not getgenv().AutoFarmEnabled or not carry or #carry:GetChildren() == 0 end end end end; if not foundItem then teleportToZone(zoneName); task.wait(1) end end end); task.wait(0.2) end end) end end})\"\n                },\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Collect\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"id\": \"CoinCollectorLogic\",\n                    \"Script\": \"getgenv().AutoCollectPlot = false; local lp = game.Players.LocalPlayer; local function getRoot() return lp.Character and lp.Character:FindFirstChild('HumanoidRootPart') end; Value:AddToggle('AutoCollectPlotToggle', {Title = 'Auto Collect', Default = false, Callback = function(V) getgenv().AutoCollectPlot = V; if V then task.spawn(function() while getgenv().AutoCollectPlot do pcall(function() local plot = workspace:FindFirstChild('Plot_' .. lp.Name); if plot then for _, floor in ipairs(plot:GetChildren()) do if floor.Name:match('^Floor') then local slots = floor:FindFirstChild('Slots'); if slots then for _, slot in ipairs(slots:GetChildren()) do local spawnObj = slot:FindFirstChild('Spawn'); if spawnObj then local hasItem = false; for _, child in ipairs(spawnObj:GetChildren()) do if not child:IsA('ProximityPrompt') then hasItem = true; break end end; if hasItem then local ct = slot:FindFirstChild('CollectTouch'); if ct and ct:FindFirstChild('TouchInterest') and getRoot() then firetouchinterest(getRoot(), ct, 0); task.wait(); firetouchinterest(getRoot(), ct, 1) end end end end end end end end end); task.wait(0.5) end end) end end})\"\n                }\n            ]\n        },\n        {\n            \"Title\": \"Teleport\",\n            \"Elements\": [\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Teleport Locations\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"id\": \"TeleportLogic\",\n                    \"Script\": \"local lp = game.Players.LocalPlayer; local zonesFolder = workspace:FindFirstChild('Zones'); local zoneValues = {}; if zonesFolder then for _, v in ipairs(zonesFolder:GetChildren()) do table.insert(zoneValues, v.Name) end end; getgenv().TeleportZone = ''; local function getRoot() local c = lp.Character or lp.CharacterAdded:Wait(); return c and c:FindFirstChild('HumanoidRootPart') end; local function teleportToZone(zoneName) local zonesF = workspace:FindFirstChild('Zones'); if not zonesF then return end; local zone = zonesF:FindFirstChild(zoneName); if not zone then return end; local hitbox = zone:FindFirstChildWhichIsA('BasePart') or zone; local root = getRoot(); if root then root.CFrame = hitbox.CFrame end end; Value:AddDropdown('TeleportZoneSelector', {Title = 'Select Zone', Values = zoneValues, Default = '', Multi = false, Callback = function(V) getgenv().TeleportZone = V end}); Value:AddButton({Title = 'Teleport to Selected', Callback = function() local selected = getgenv().TeleportZone; if selected and selected ~= '' then teleportToZone(selected) end end}); Value:AddButton({Title = 'Teleport to Base', Callback = function() local plot = workspace:FindFirstChild('Plot_' .. lp.Name); local root = getRoot(); if plot and root then root.CFrame = plot:GetPivot() end end})\"\n                }\n            ]\n        },\n        {\n            \"Title\": \"Shop\",\n            \"Elements\": [\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Auto Buy\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"id\": \"ShopLogic\",\n                    \"Script\": \"getgenv().AutoBuySpeed = false; getgenv().AutoBuyCarry = false; getgenv().SpeedAmount = 10; Value:AddDropdown('SpeedAmountDropdown', {Title = 'Speed Amount', Values = {'1', '5', '10'}, Default = '10', Multi = false, Callback = function(V) getgenv().SpeedAmount = tonumber(V) end}); Value:AddToggle('AutoBuySpeedToggle', {Title = 'Auto Buy Speed', Default = false, Callback = function(V) getgenv().AutoBuySpeed = V; if V then task.spawn(function() while getgenv().AutoBuySpeed do pcall(function() game:GetService('ReplicatedStorage').Events.PurchaseSpeed:FireServer(getgenv().SpeedAmount) end); task.wait(.1) end end) end end}); Value:AddToggle('AutoBuyCarryToggle', {Title = 'Auto Buy Carry', Default = false, Callback = function(V) getgenv().AutoBuyCarry = V; if V then task.spawn(function() while getgenv().AutoBuyCarry do pcall(function() game:GetService('ReplicatedStorage').Events.PurchaseCarry:FireServer() end); task.wait(1) end end) end end})\"\n                }\n            ]\n        }\n    ]\n}"
getgenv().NEXS_PACKAGE["Script/Games/SlideForBrainrots.json"] = "\239\187\191{\n    \"Tabs\": [\n        {\n            \"Title\": \"Auto Matic\",\n            \"Elements\": [\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Brainrot\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"id\": \"SlideFarmLogic\",\n                    \"Script\": \"local lp = game.Players.LocalPlayer\\ngetgenv().SelectedCategories = {['All'] = true}\\ngetgenv().SelectedBrainrots = {['All'] = true}\\ngetgenv().AutoFarmEnabled = false\\n\\nlocal assetsFolder = game:GetService('ReplicatedStorage').Assets.Brainrots\\nlocal gameplay = workspace:FindFirstChild('Gameplay')\\n\\nlocal function dprint(...) end\\n\\nlocal claimFrozen = false\\nlocal fallbackCursor = 0\\nlocal lastFallbackAreaName = nil\\nlocal lastFallbackTeleportAt = 0\\n\\nlocal function getRoot()\\n    local char = lp.Character\\n    if not char then\\n        return nil\\n    end\\n    local root = char:FindFirstChild('HumanoidRootPart')\\n    if root then\\n        return root\\n    end\\n    return char:WaitForChild('HumanoidRootPart', 0.35)\\nend\\n\\nlocal function isDead()\\n    local hum = lp.Character and lp.Character:FindFirstChildOfClass('Humanoid')\\n    return hum and hum.Health <= 0\\nend\\n\\nlocal function setClaimFreeze(enabled)\\n    local root = getRoot()\\n    if enabled then\\n        if root and not claimFrozen then\\n            root.CFrame = root.CFrame * CFrame.new(0, 100, 0)\\n            task.wait(0.25)\\n            if root.Parent and lp.Character and lp.Character:FindFirstChild('HumanoidRootPart') == root then\\n                root.Anchored = true\\n                claimFrozen = true\\n            end\\n        end\\n    else\\n        if claimFrozen then\\n            if root then\\n                root.Anchored = false\\n            end\\n            claimFrozen = false\\n        end\\n    end\\nend\\n\\nlp.CharacterAdded:Connect(function()\\n    claimFrozen = false\\nend)\\n\\nlocal function getCategories()\\n    local cats = {'All'}\\n    for _, v in ipairs(assetsFolder:GetChildren()) do\\n        table.insert(cats, v.Name)\\n    end\\n    return cats\\nend\\n\\nlocal function getValidNames()\\n    local names = {}\\n    local selCats = getgenv().SelectedCategories\\n    for _, catFolder in ipairs(assetsFolder:GetChildren()) do\\n        if selCats['All'] or selCats[catFolder.Name] then\\n            for _, item in ipairs(catFolder:GetChildren()) do\\n                local nameAttr = item:GetAttribute('Name')\\n                if nameAttr then\\n                    names[nameAttr] = true\\n                end\\n            end\\n        end\\n    end\\n    return names\\nend\\n\\nlocal function getBrainrotsForCategories()\\n    local list = {'All'}\\n    local names = getValidNames()\\n    for name, _ in pairs(names) do\\n        table.insert(list, name)\\n    end\\n    return list\\nend\\n\\nlocal function getSelectedAreaTypes()\\n    local types = {}\\n    local selected = getgenv().SelectedCategories\\n    if selected['All'] then\\n        return nil\\n    end\\n    for name, enabled in pairs(selected) do\\n        if enabled and name ~= 'All' then\\n            types[name] = true\\n        end\\n    end\\n    return types\\nend\\n\\nlocal function detectorHasAreaName(detectors, areaName)\\n    if not detectors then\\n        return false\\n    end\\n    if detectors:FindFirstChild(areaName) then\\n        return true\\n    end\\n    for _, item in ipairs(detectors:GetDescendants()) do\\n        if item.Name == 'Name' then\\n            local ok, value = pcall(function()\\n                if item:IsA('StringValue') then\\n                    return item.Value\\n                end\\n                if item:IsA('ObjectValue') then\\n                    return item.Value and item.Value.Name or nil\\n                end\\n                if item:IsA('ValueBase') then\\n                    return tostring(item.Value)\\n                end\\n                return nil\\n            end)\\n            if ok and value == areaName then\\n                return true\\n            end\\n        end\\n    end\\n    return false\\nend\\n\\nlocal function getTeleportCFrame(inst)\\n    if not inst then\\n        return nil\\n    end\\n    if inst:IsA('BasePart') then\\n        return inst.CFrame\\n    end\\n    if inst:IsA('Model') then\\n        return inst:GetPivot()\\n    end\\n    local model = inst:FindFirstChildWhichIsA('Model', true)\\n    if model then\\n        return model:GetPivot()\\n    end\\n    local part = inst:FindFirstChildWhichIsA('BasePart', true)\\n    if part then\\n        return part.CFrame\\n    end\\n    return nil\\nend\\n\\nlocal function getFallbackAreas()\\n    if not gameplay then\\n        dprint('Gameplay missing')\\n        return {}\\n    end\\n    local areas = gameplay:FindFirstChild('BrainrotAreas')\\n    if not areas then\\n        dprint('BrainrotAreas missing')\\n        return {}\\n    end\\n    local list = {}\\n    local detectors = gameplay:FindFirstChild('AreaDetectors')\\n    local selectedTypes = getSelectedAreaTypes()\\n    for _, area in ipairs(areas:GetChildren()) do\\n        local areaType = area:GetAttribute('AreaType')\\n        local typeMatch = (selectedTypes == nil) or (areaType and selectedTypes[areaType])\\n        if typeMatch and (not detectorHasAreaName(detectors, area.Name)) then\\n            table.insert(list, area)\\n        end\\n    end\\n    return list\\nend\\n\\nlocal function findFallbackArea(now)\\n    local candidates = getFallbackAreas()\\n    local count = #candidates\\n    if count == 0 then\\n        return nil\\n    end\\n\\n    fallbackCursor = (fallbackCursor % count) + 1\\n    local start = fallbackCursor\\n    for i = 0, count - 1 do\\n        local idx = ((start + i - 1) % count) + 1\\n        local area = candidates[idx]\\n        if area.Name ~= lastFallbackAreaName or (now - lastFallbackTeleportAt) >= 6 then\\n            fallbackCursor = idx\\n            return area\\n        end\\n    end\\n\\n    return nil\\nend\\n\\nlocal brainrotDrop\\nValue:AddDropdown('CategorySelector', {\\n    Title = 'Select Rarity',\\n    Values = getCategories(),\\n    Default = {'All'},\\n    Multi = true,\\n    Callback = function(V)\\n        getgenv().SelectedCategories = V\\n        fallbackCursor = 0\\n        lastFallbackAreaName = nil\\n        lastFallbackTeleportAt = 0\\n        local newItems = getBrainrotsForCategories()\\n        if brainrotDrop then\\n            pcall(function()\\n                brainrotDrop:SetValues(newItems)\\n            end)\\n        end\\n        getgenv().SelectedBrainrots = {['All'] = true}\\n    end\\n})\\n\\nbrainrotDrop = Value:AddDropdown('BrainrotSelector', {\\n    Title = 'Select Brainrots',\\n    Values = getBrainrotsForCategories(),\\n    Default = {'All'},\\n    Multi = true,\\n    Callback = function(V)\\n        getgenv().SelectedBrainrots = V\\n    end\\n})\\n\\nlocal function isTarget(obj)\\n    local nameAttr = obj:GetAttribute('Name')\\n    if not nameAttr then\\n        return false\\n    end\\n    local validNames = getValidNames()\\n    if not validNames[nameAttr] then\\n        return false\\n    end\\n    local selected = getgenv().SelectedBrainrots\\n    if selected['All'] then\\n        return true\\n    end\\n    return selected[nameAttr] ~= nil\\nend\\n\\nValue:AddToggle('FarmToggle', {\\n    Title = 'Auto Take',\\n    Default = false,\\n    Callback = function(V)\\n        getgenv().AutoFarmEnabled = V\\n        if V then\\n            task.spawn(function()\\n                local nextAreaTeleport = 0\\n                while getgenv().AutoFarmEnabled do\\n                    pcall(function()\\n                        if isDead() then\\n                            setClaimFreeze(false)\\n                            return\\n                        end\\n\\n                        if lp:GetAttribute('CarryingBrainrot') == true then\\n                            setClaimFreeze(true)\\n                            local ohString1 = 'ClaimBrainrots'\\n                            while getgenv().AutoFarmEnabled and lp:GetAttribute('CarryingBrainrot') == true do\\n                                game:GetService('ReplicatedStorage').Modules.EventManagerClient.ServerEvent:FireServer(ohString1)\\n                                task.wait(1)\\n                                if isDead() then\\n                                    break\\n                                end\\n                            end\\n                            setClaimFreeze(false)\\n                        else\\n                            setClaimFreeze(false)\\n                            local brainrotsWorld = gameplay and gameplay:FindFirstChild('Brainrots')\\n                            local target = nil\\n                            local targetPrompt = nil\\n\\n                            if brainrotsWorld then\\n                                for _, br in ipairs(brainrotsWorld:GetChildren()) do\\n                                    if isTarget(br) then\\n                                        local mesh = br:FindFirstChild('Mesh')\\n                                        local prompt = mesh and mesh:FindFirstChildWhichIsA('ProximityPrompt')\\n                                        if prompt and prompt.Enabled then\\n                                            target = br\\n                                            targetPrompt = prompt\\n                                            break\\n                                        end\\n                                    end\\n                                end\\n                            end\\n\\n                            if target and targetPrompt and getRoot() then\\n                                local root = getRoot()\\n                                repeat\\n                 