getgenv().NEXS_PACKAGE["Script/Games/50DaysOnARaft/InGame.json"] = "{\n    \"Tabs\":  [\n                 {\n                     \"Title\":  \"Items\",\n                     \"Elements\":  [\n                                      {\n                                          \"Type\":  \"Section\",\n                                          \"Title\":  \"Items Control\"\n                                      },\n                                      {\n                                          \"Type\":  \"Logic\",\n                                          \"Script\":  \"local Players = game:GetService(\\u0027Players\\u0027)\\nlocal lp = Players.LocalPlayer\\n\\nlocal PickablesDropdown = Value:AddDropdown(\\u0027Raft_Pickables\\u0027, {Title = \\u0027Select Item\\u0027, Values = {\\u0027All\\u0027, \\u0027None\\u0027}, Default = \\u0027All\\u0027})\\nlocal skipToggle = true\\nValue:AddToggle(\\u0027Raft_SkipNearby\\u0027, {Title = \\u0027Skip Nearby Items\\u0027, Default = true, Callback = function(v) skipToggle = v end})\\n\\nlocal currentMap = {}\\nlocal debounce = false\\nlocal connections = {}\\n\\nlocal function disconnectAll(list)\\n    for _, c in ipairs(list) do\\n        if c then\\n            c:Disconnect()\\n        end\\n    end\\n    table.clear(list)\\nend\\n\\nlocal function canPivot(inst)\\n    return inst and (inst:IsA(\\u0027Model\\u0027) or inst:IsA(\\u0027BasePart\\u0027))\\nend\\n\\nlocal function addTarget(targets, seen, obj)\\n    if not canPivot(obj) then return end\\n    if seen[obj] then return end\\n    seen[obj] = true\\n    table.insert(targets, obj)\\nend\\n\\nlocal function collectTargets()\\n    local targets = {}\\n    local seen = {}\\n\\n    local pickables = workspace:FindFirstChild(\\u0027Pickables\\u0027)\\n    if pickables then\\n        for _, obj in ipairs(pickables:GetChildren()) do\\n            addTarget(targets, seen, obj)\\n        end\\n    end\\n\\n    local generated = workspace:FindFirstChild(\\u0027Generated\\u0027)\\n    if generated then\\n        for _, inst in ipairs(generated:GetDescendants()) do\\n            if inst.Name == \\u0027Pickup\\u0027 then\\n                addTarget(targets, seen, inst.Parent)\\n            end\\n        end\\n    end\\n\\n    return targets\\nend\\n\\nlocal function itemStillExists(name)\\n    if not name or name == \\u0027None\\u0027 then return false end\\n    for _, obj in ipairs(collectTargets()) do\\n        if obj.Name == name then\\n            return true\\n        end\\n    end\\n    return false\\nend\\n\\nlocal function refreshItems()\\n    if debounce then return end\\n    debounce = true\\n\\n    task.spawn(function()\\n        task.wait(0.08)\\n\\n        local names = {}\\n        for _, obj in ipairs(collectTargets()) do\\n            names[obj.Name] = true\\n        end\\n\\n        local list = {}\\n        currentMap = {}\\n        for name in pairs(names) do\\n            table.insert(list, name)\\n            currentMap[name] = name\\n        end\\n\\n        table.sort(list)\\n        table.insert(list, 1, \\u0027All\\u0027)\\n        if #list == 1 then\\n            table.insert(list, \\u0027None\\u0027)\\n        end\\n\\n        PickablesDropdown:SetValues(list)\\n        debounce = false\\n    end)\\nend\\n\\nlocal function maybeRefreshItems()\\n    local selected = PickablesDropdown and PickablesDropdown.Value\\n    if not selected or selected == \\u0027None\\u0027 then\\n        return\\n    end\\n\\n    local baseName = currentMap[selected] or selected\\n    if not itemStillExists(baseName) then\\n        refreshItems()\\n    end\\nend\\n\\nlocal function getPickupRemote()\\n    local rs = game:GetService(\\u0027ReplicatedStorage\\u0027)\\n    local remotes = rs:FindFirstChild(\\u0027Remotes\\u0027)\\n    return remotes and remotes:FindFirstChild(\\u0027PickupEvent\\u0027)\\nend\\n\\nlocal function resolvePickupInstances(targetObj)\\n    local ohInstance3 = targetObj\\n    local ohInstance2 = targetObj:FindFirstChildWhichIsA(\\u0027BasePart\\u0027, true)\\n\\n    if not ohInstance2 then\\n        local descendants = targetObj:GetDescendants()\\n        for i = #descendants, 1, -1 do\\n            local d = descendants[i]\\n            if d:IsA(\\u0027BasePart\\u0027) then\\n                ohInstance2 = d\\n                break\\n            end\\n        end\\n    end\\n\\n    if not ohInstance2 then\\n        local descendants = targetObj:GetDescendants()\\n        ohInstance2 = descendants[#descendants]\\n    end\\n\\n    return ohInstance2, ohInstance3\\nend\\n\\nlocal function bindWatchers()\\n    disconnectAll(connections)\\n\\n    table.insert(connections, workspace.ChildAdded:Connect(function(c)\\n        if c.Name == \\u0027Pickables\\u0027 or c.Name == \\u0027Generated\\u0027 then\\n            refreshItems()\\n            task.defer(bindWatchers)\\n        end\\n    end))\\n\\n    table.insert(connections, workspace.ChildRemoved:Connect(function(c)\\n        if c.Name == \\u0027Pickables\\u0027 or c.Name == \\u0027Generated\\u0027 then\\n            maybeRefreshItems()\\n            task.defer(bindWatchers)\\n        end\\n    end))\\n\\n    local pickables = workspace:FindFirstChild(\\u0027Pickables\\u0027)\\n    if pickables then\\n        table.insert(connections, pickables.ChildAdded:Connect(refreshItems))\\n        table.insert(connections, pickables.ChildRemoved:Connect(maybeRefreshItems))\\n    end\\n\\n    local generated = workspace:FindFirstChild(\\u0027Generated\\u0027)\\n    if generated then\\n        table.insert(connections, generated.DescendantAdded:Connect(function(inst)\\n            if inst.Name == \\u0027Pickup\\u0027 then\\n                refreshItems()\\n            end\\n        end))\\n\\n        table.insert(connections, generated.DescendantRemoving:Connect(function(inst)\\n            if inst.Name == \\u0027Pickup\\u0027 then\\n                maybeRefreshItems()\\n            end\\n        end))\\n    end\\nend\\n\\nlocal function getSelectedTargetObject(baseName, hrp)\\n    if not baseName or baseName == \\u0027None\\u0027 or baseName == \\u0027All\\u0027 then return nil end\\n\\n    local targetObj = nil\\n    local minDist = math.huge\\n\\n    for _, obj in ipairs(collectTargets()) do\\n        if obj.Name == baseName then\\n            local pivot = obj:GetPivot()\\n            local dist = (hrp.Position - pivot.Position).Magnitude\\n            if skipToggle and dist \\u003c 15 then\\n                continue\\n            end\\n            if dist \\u003c minDist then\\n                minDist = dist\\n                targetObj = obj\\n            end\\n        end\\n    end\\n\\n    return targetObj\\nend\\n\\nlocal function getAllTargetObjects(hrp)\\n    local out = {}\\n    for _, obj in ipairs(collectTargets()) do\\n        local pivot = obj:GetPivot()\\n        local dist = (hrp.Position - pivot.Position).Magnitude\\n        if not (skipToggle and dist \\u003c 15) then\\n            table.insert(out, {obj = obj, dist = dist})\\n        end\\n    end\\n\\n    table.sort(out, function(a, b)\\n        return a.dist \\u003c b.dist\\n    end)\\n\\n    return out\\nend\\n\\nValue:AddButton({\\n    Title = \\u0027Pull Selected\\u0027,\\n    Callback = function()\\n        local selected = PickablesDropdown.Value\\n        local baseName = currentMap[selected] or selected\\n        if not baseName or baseName == \\u0027None\\u0027 then return end\\n\\n        local char = lp.Character\\n        local hrp = char and char:FindFirstChild(\\u0027HumanoidRootPart\\u0027)\\n        if not hrp then return end\\n\\n        local pickupRemote = getPickupRemote()\\n\\n        if baseName == \\u0027All\\u0027 then\\n            for _, entry in ipairs(getAllTargetObjects(hrp)) do\\n                local targetObj = entry.obj\\n                targetObj:PivotTo(hrp.CFrame)\\n                local ohInstance2, ohInstance3 = resolvePickupInstances(targetObj)\\n                if pickupRemote and ohInstance2 and ohInstance3 then\\n                    pcall(function()\\n                        pickupRemote:FireServer(true, ohInstance2, ohInstance3)\\n                    end)\\n                end\\n                task.wait()\\n            end\\n            return\\n        end\\n\\n        local targetObj = getSelectedTargetObject(baseName, hrp)\\n        if targetObj then\\n            targetObj:PivotTo(hrp.CFrame)\\n\\n            local ohInstance2, ohInstance3 = resolvePickupInstances(targetObj)\\n            if pickupRemote and ohInstance2 and ohInstance3 then\\n                pcall(function()\\n                    pickupRemote:FireServer(true, ohInstance2, ohInstance3)\\n                end)\\n            end\\n        end\\n    end\\n})\\n\\nbindWatchers()\\ntask.spawn(refreshItems)\"\n                                      }\n                                  ]\n                 }\n             ]\n}\n"
