getgenv().NEXS_PACKAGE["Script/Games/FlyForBrainrots.json"] = "\239\187\191{\n    \"Tabs\": [\n        {\n            \"Title\": \"Auto Matic\",\n            \"Elements\": [\n                {\n                    \"Type\": \"Section\",\n                    \"Title\": \"Brainrot\"\n                },\n                {\n                    \"Type\": \"Logic\",\n                    \"id\": \"FlyForBrainrotsLogic\",\n                    \"Script\": \"local Players = game:GetService(\\u0027Players\\u0027)\\nlocal lp = Players.LocalPlayer\\n\\ngetgenv().FlySelectedRarities = {All = true}\\ngetgenv().FlySelectedBrainrots = {All = true}\\ngetgenv().FlyAutoTakeEnabled = false\\n\\nlocal rarityDropdown\\nlocal brainrotDropdown\\n\\nlocal cachedDropButton = nil\\nlocal dropVisibleFast = false\\nlocal dropVisibleConn = nil\\nlocal dropAncestryConn = nil\\n\\nlocal function normalizeSelection(raw, valid)\\n    local out = {}\\n    local hasSpecific = false\\n\\n    local function addName(name)\\n        if type(name) ~= \\u0027string\\u0027 then return end\\n        if not valid[name] then return end\\n        out[name] = true\\n        hasSpecific = hasSpecific or (name ~= \\u0027All\\u0027)\\n    end\\n\\n    if type(raw) == \\u0027string\\u0027 then\\n        addName(raw)\\n    elseif type(raw) == \\u0027table\\u0027 then\\n        for _, v in pairs(raw) do\\n            if type(v) == \\u0027string\\u0027 then addName(v) end\\n        end\\n        for k, v in pairs(raw) do\\n            if type(k) == \\u0027string\\u0027 and v then addName(k) end\\n        end\\n    end\\n\\n    if not hasSpecific and next(out) == nil then\\n        out.All = true\\n    end\\n\\n    if hasSpecific then\\n        out.All = nil\\n    end\\n\\n    return out\\nend\\n\\nlocal function getRarityValues()\\n    local values = {\\u0027All\\u0027}\\n    local valid = {All = true}\\n    local zones = workspace:FindFirstChild(\\u0027RarityZones\\u0027)\\n    if zones then\\n        for _, child in ip