                                  \"Type\":  \"Section\",\n                                          \"Title\":  \"Buy Stamina\"\n                                      },\n                                      {\n                                          \"Type\":  \"Logic\",\n                                          \"id\":  \"ShopAutoStaminaLogic\",\n                                          \"Script\":  \"getgenv().AutoStaminaEnabled = false\\nlocal events = game:GetService(\\u0027ReplicatedStorage\\u0027):WaitForChild(\\u0027shared/network/GlobalEvents@GlobalEvents\\u0027)\\nValue:AddToggle(\\u0027AutoStaminaToggle\\u0027, {\\n    Title = \\u0027Auto Buy Stamina\\u0027,\\n    Default = false,\\n    Callback = function(v)\\n        getgenv().AutoStaminaEnabled = v\\n        if v then\\n            task.spawn(function()\\n                while getgenv().AutoStaminaEnabled do\\n                    events.StaminaPurchaseRequest:FireServer()\\n                    task.wait(0.1)\\n                end\\n            end)\\n        end\\n    end\\n})\"\n                                      }\n                                  ]\n                 }\n             ]\n}\n"
getgenv().NEXS_PACKAGE["Script/Games/CommandYourCloneArmy.json"] = "\239\187\191{\n    \"Tabs\":  [\n                 {\n                     \"Title\":  \"Auto Farm\",\n                     \"Elements\":  [\n                                      {\n                                          \"Type\":  \"Section\",\n                                          \"Title\":  \"Attack\"\n                                      },\n                                      {\n                                          \"Type\":  \"Logic\",\n                                          \"Script\":  \"local function getAreas()\\n    local seen = {}\\n    local searchContainers = {workspace}\\n    if workspace:FindFirstChild(\\u0027RunArea\\u0027) then\\n        table.insert(searchContainers, workspace.RunArea)\\n    end\\n    for _, container in ipairs(searchContainers) do\\n        for _, child in ipairs(container:GetChildren()) do\\n            local num = child.Name:match(\\u0027^RunAreaChunk_(%d+)\\u0027)\\n            if num then\\n                seen[tonumber(num)] = true\\n            end\\n        end\\n    end\\n\\n    local nums = {}\\n    for n in pairs(seen) do\\n        table.insert(nums, n)\\n    end\\n    table.sort(nums)\\n\\n    local areas = {\\u0027All\\u0027}\\n    if #nums \\u003e 0 then\\n        for _, n in ipairs(nums) do\\n            table.insert(areas, \\u0027Area \\u0027 .. n)\\n        end\\n    else\\n        for i = 1, 15 do\\n            table.insert(areas, \\u0027Area \\u0027 .. i)\\n        end\\n    end\\n    return areas\\nend\\n\\nlocal function normalizeSelection(v)\\n    local selected = {}\\n\\n    local function addValue(x)\\n        if type(x) == \\u0027string\\u0027 then\\n            selected[x] = true\\n            return\\n        end\\n\\n        if type(x) == \\u0027number\\u0027 then\\n            if x == -1 then\\n                selected[\\u0027All\\u0027] = true\\n            else\\n                selected[\\u0027Area \\u0027 .. tostring(x)] = true\\n            end\\n            return\\n        end\\n\\n        if type(x) == \\u0027table\\u0027 then\\n            if x.Value ~= nil then\\n                addValue(x.Value)\\n            end\\n            for _, item in ipairs(x) do\\n                addValue(item)\\n            end\\n            for key, enabled in pairs(x) do\\n                if type(key) == \\u0027string\\u0027 and enabled then\\n                    addValue(key)\\n                end\\n            end\\n        end\\n    end\\n\\n    addValue(v)\\n\\n    local hasNonAll = false\\n    for name, enabled in pairs(selected) do\\n        if enabled and name ~= \\u0027All\\u0027 then\\n            hasNonAll = true\\n            break\\n        end\\n    end\\n    if hasNonAll then\\n        selected[\\u0027All\\u0027] = nil\\n    end\\n\\n    if next(selected) == nil then\\n        selected[\\u0027All\\u0027] = true\\n    end\\n\\n    return selected\\nend\\n\\nlocal function getSelectedAreasLive()\\n    local optionObj = Options and Options.CYA_AreaSelect\\n    if optionObj then\\n        local liveValue = nil\\n        pcall(function()\\n            liveValue = optionObj.Value\\n        end)\\n        if liveValue == nil then\\n            pcall(function()\\n                if optionObj.GetValue then\\n                    liveValue = optionObj:GetValue()\\n                end\\n            end)\\n        end\\n        if liveValue ~= nil then\\n            getgenv().SelectedAreas = normalizeSelection(liveValue)\\n            return getgenv().SelectedAreas\\n        end\\n    end\\n\\n    getgenv().SelectedAreas = normalizeSelection(getgenv().SelectedAreas)\\n    return getgenv().SelectedAreas\\nend\\n\\nlocal function isAllSelected(selected)\\n    for name, enabled in pairs(selected or {}) do\\n        if enabled and name ~= \\u0027All\\u0027 then\\n            return false\\n        end\\n    end\\n    return true\\nend\\n\\nlocal function getNpcAreaNumber(npcName)\\n    local npcAreaStr = tostring(npcName):match(\\u0027^run_%d+_(%d+)_%d+$\\u0027)\\n    if not npcAreaStr then\\n        npcAreaStr = tostring(npcName):match(\\u0027_(%d+)_%d+$\\u0027)\\n    end\\n    return tonumber(npcAreaStr)\\nend\\n\\nlocal function matchesArea(npcName, selectedAreas)\\n    local selected = normalizeSelection(selectedAreas)\\n    if isAllSelected(selected) or selected[\\u0027All\\u0027] then\\n        return true\\n    end\\n\\n    local npcAreaNumber = getNpcAreaNumber(npcName)\\n    if not npcAreaNumber then\\n        return false\\n    end\\n\\n    for areaName, enabled in pairs(selected) do\\n        if enabled and areaName ~= \\u0027All\\u0027 then\\n            local areaNum = tonumber(tostring(areaName):match(\\u0027%d+\\u0027))\\n            if areaNum and npcAreaNumber == areaNum then\\n                return true\\n            end\\n        end\\n    end\\n\\n    return false\\nend\\n\\nlocal function extractUserIdFromFolderName(folderName)\\n    return tostring(folderName or \\u0027\\u0027):match(\\u0027^Player_(%d+)$\\u0027)\\nend\\n\\nlocal function getAllCloneCandidates()\\n    local out = {}\\n    local npcsRoot = workspace:FindFirstChild(\\u0027NPCs\\u0027)\\n    if not npcsRoot then\\n        return out\\n    end\\n\\n    for _, ownerFolder in ipairs(npcsRoot:GetChildren()) do\\n        local ownerUserId = extractUserIdFromFolderName(ownerFolder.Name)\\n        if ownerUserId then\\n            for _, unit in ipairs(ownerFolder:GetChildren()) do\\n                if unit and unit.Name then\\n                    table.insert(out, {\\n                        ownerUserId = ownerUserId,\\n                        targetName = unit.Name\\n                    })\\n                end\\n            end\\n        end\\n    end\\n\\n    return out\\nend\\n\\nlocal function getCloneAttackTarget()\\n    local candidates = getAllCloneCandidates()\\n    if #candidates == 0 then\\n        getgenv().LockedCloneOwnerUserId = nil\\n        getgenv().LockedCloneTargetName = nil\\n        return nil, nil\\n    end\\n\\n    local mode = getgenv().CloneSoldierMode or \\u0027Random\\u0027\\n    if mode == \\u0027Single Focus\\u0027 then\\n        local lockedOwner = getgenv().LockedCloneOwnerUserId\\n        local lockedTarget = getgenv().LockedCloneTargetName\\n        if lockedOwner and lockedTarget then\\n            for _, c in ipairs(candidates) do\\n                if c.ownerUserId == lockedOwner and c.targetName == lockedTarget then\\n                    return c.targetName, c.ownerUserId\\n                end\\n            end\\n        end\\n\\n        local pick = candidates[1]\\n        getgenv().LockedCloneOwnerUserId = pick.ownerUserId\\n        getgenv().LockedCloneTargetName = pick.targetName\\n        return pick.targetName, pick.ownerUserId\\n    end\\n\\n    local pick = candidates[math.random(1, #candidates)]\\n    return pick.targetName, pick.ownerUserId\\nend\\n\\nlocal function getPrimarySelectedAreaNumber(selectedAreas)\\n    local selected = normalizeSelection(selectedAreas)\\n    if selected[\\u0027All\\u0027] then\\n        return nil\\n    end\\n    for areaName, enabled in pairs(selected) do\\n        if enabled and areaName ~= \\u0027All\\u0027 then\\n            local areaNum = tonumber(tostring(areaName):match(\\u0027%d+\\u0027))\\n            if areaNum then\\n                return areaNum\\n            end\\n        end\\n    end\\n    return nil\\nend\\n\\nlocal function getAreaWaitCFrame(selectedAreas)\\n    local areaNum = getPrimarySelectedAreaNumber(selectedAreas)\\n    if not areaNum then\\n        return nil\\n    end\\n\\n    local targets = {workspace}\\n    local runArea = workspace:FindFirstChild(\\u0027RunArea\\u0027)\\n    if runArea then\\n        table.insert(targets, runArea)\\n    end\\n\\n    local chunkName = \\u0027RunAreaChunk_\\u0027 .. tostring(areaNum)\\n    for _, container in ipairs(targets) do\\n        local chunk = container:FindFirstChild(chunkName)\\n     