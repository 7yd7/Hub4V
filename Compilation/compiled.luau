getgenv().NEXS_PACKAGE["Script/Games/ClimbForBrainrots.json"] = "\239\187\191{\n    \"Tabs\":  [\n                 {\n                     \"Title\":  \"Auto Matic\",\n                     \"Elements\":  [\n                                      {\n                                          \"Type\":  \"Section\",\n                                          \"Title\":  \"Brainrot\"\n                                      },\n                                      {\n                                          \"Type\":  \"Logic\",\n                                          \"id\":  \"ClimbFarmLogic\",\n                                          \"Script\":  \"local lp = game.Players.LocalPlayer\\r\\ngetgenv().SelectedRarities = {[\\u0027All\\u0027] = true}\\r\\ngetgenv().SelectedBrainrots = {[\\u0027All\\u0027] = true}\\r\\ngetgenv().AutoFarmEnabled = false\\r\\n\\r\\n-- Robust String Utilities\\r\\nlocal function trim(s)\\r\\n    s = tostring(s or \\u0027\\u0027)\\r\\n    return (s:gsub(\\u0027^%s*(.-)%s*$\\u0027, \\u0027%1\\u0027))\\r\\nend\\r\\n\\r\\nlocal function stripTags(s)\\r\\n    s = tostring(s or \\u0027\\u0027)\\r\\n    return (s:gsub(\\u0027\\u003c[^\\u003e]-\\u003e\\u0027, \\u0027\\u0027))\\r\\nend\\r\\n\\r\\nlocal function cleanName(name)\\r\\n    name = tostring(name or \\u0027\\u0027)\\r\\n    return (name:gsub(\\u0027^%d+_\\u0027, \\u0027\\u0027))\\r\\nend\\r\\n\\r\\nlocal function getGuiFolder()\\r\\n    local gui = lp:FindFirstChild(\\u0027PlayerGui\\u0027)\\r\\n    local main = gui and gui:FindFirstChild(\\u0027MainScreen\\u0027)\\r\\n    local center = main and main:FindFirstChild(\\u0027CenterScreen\\u0027)\\r\\n    local index = center and center:FindFirstChild(\\u0027Index\\u0027)\\r\\n    return index and index:FindFirstChild(\\u0027Scrolling\\u0027)\\r\\nend\\r\\n\\r\\n-- Helper to get rarity text safely\\r\\nlocal function getRarityText(button)\\r\\n    local rarityObj = button:FindFirstChild(\\u0027Rarity\\u0027)\\r\\n    if rarityObj and (rarityObj:IsA(\\u0027TextLabel\\u0027) or rarityObj:IsA(\\u0027TextBox\\u0027)) then\\r\\n        return trim(stripTags(rarityObj.Text))\\r\\n    end\\r\\n    return nil\\r\\nend\\r\\n\\r\\nlocal function getRarities()\\r\\n    local rarities = {\\u0027All\\u0027}\\r\\n    local seen = {}\\r\\n    local folder = getGuiFolder()\\r\\n    if folder then\\r\\n        for _, v in ipairs(folder:GetChildren()) do\\r\\n            if v:IsA(\\u0027ImageButton\\u0027) then\\r\\n                local rarity = getRarityText(v)\\r\\n                if rarity and rarity ~= \\u0027\\u0027 and not seen[rarity] then\\r\\n                    table.insert(rarities, rarity)\\r\\n                    seen[rarity] = true\\r\\n                end\\r\\n            end\\r\\n        end\\r\\n    end\\r\\n    return rarities\\r\\nend\\r\\n\\r\\nlocal function getBrainrots(selectedRarities)\\r\\n    local list = {\\u0027All\\u0027}\\r\\n    local seen = {}\\r\\n    local folder = getGuiFolder()\\r\\n    if folder then\\r\\n        for _, v in ipairs(folder:GetChildren()) do\\r\\n            if v:IsA(\\u0027ImageButton\\u0027) then\\r\\n                local rarity = getRarityText(v)\\r\\n                local isAll = selectedRarities[\\u0027All\\u0027]\\r\\n                local rarityMatch = isAll\\r\\n\\r\\n                if not rarityMatch and rarity then\\r\\n                    for selRarity, enabled in pairs(selectedRarities) do\\r\\n                        if enabled and string.lower(trim(selRarity)) == string.lower(trim(rarity)) then\\r\\n                            rarityMatch = true\\r\\n                            break\\r\\n                        end\\r\\n                    end\\r\\n                end\\r\\n\\r\\n                if rarityMatch then\\r\\n                    local cleaned = cleanName(v.Name)\\r\\n                    if not seen[cleaned] then\\r\\n                        table.insert(list, cleaned)\\r\\n                        seen[cleaned] = true\\r\\n                    end\\r\\n                end\\r\\n            end\\r\\n        end\\r\\n    end\\r\\n    return list\\r\\nend\\r\\n\\r\\nlocal brainrotDrop\\r\\n\\r\\nValue:AddDropdown(\\u0027RaritySelector\\u0027, {\\r\\n    Title = \\u0027Select Rarity\\u0027,\\r\\n    Values = getRarities(),\\r\\n    Default = {\\u0027All\\u0027},\\r\\n    Multi = true,\\r\\n    Callback = function(V)\\r\\n        getgenv().SelectedRarities = V\\r\\n        local newBrainrots = getBrainrots(V)\\r\\n        if brainrotDrop then\\r\\n            pcall(function()\\r\\n                brainrotDrop:SetValues(newBrainrots)\\r\\n            end)\\r\\n        end\\r\\n    end\\r\\n})\\r\\n\\r\\nbrainrotDrop = Value:AddDropdown(\\u0027BrainrotSelector\\u0027, {\\r\\n    Title = \\u0027Select Brainrots\\u0027,\\r\\n    Values = getBrainrots({[\\u0027All\\u0027] = true}),\\r\\n    Default = {\\u0027All\\u0027},\\r\\n    Multi = true,\\r\\n    Callback = function(V)\\r\\n        getgenv().SelectedBrainrots = V\\r\\n    end\\r\\n})\\r\\n\\r\\nlocal function getRoot()\\r\\n    return lp.Character and lp.Character:FindFirstChild(\\u0027HumanoidRootPart\\u0027)\\r\\nend\\r\\n\\r\\nlocal function isHolding()\\r\\n    local gui = lp:FindFirstChild(\\u0027PlayerGui\\u0027)\\r\\n    local main = gui and gui:FindFirstChild(\\u0027MainScreen\\u0027)\\r\\n    local center = main and main:FindFirstChild(\\u0027CenterScreen\\u0027)\\r\\n    local holding = center and center:FindFirstChild(\\u0027HoldingBrainrot\\u0027)\\r\\n    return holding and holding.Visible\\r\\nend\\r\\n\\r\\n-- Robust Target Check\\r\\nlocal function isTarget(entity)\\r\\n    if entity:FindFirstChildOfClass(\\u0027Humanoid\\u0027) then return false end\\r\\n\\r\\n    local charIdAttr = entity:GetAttribute(\\u0027CharacterId\\u0027)\\r\\n    if not charIdAttr then return false end\\r\\n    local charId = tostring(charIdAttr)\\r\\n    local cleanedCharId = cleanName(charId)\\r\\n    \\r\\n    -- Find the corresponding button in the UI to get its rarity\\r\\n    local folder = getGuiFolder()\\r\\n    local targetRarity = nil\\r\\n    \\r\\n    if folder then\\r\\n        for _, v in ipairs(folder:GetChildren()) do\\r\\n            if v:IsA(\\u0027ImageButton\\u0027) then\\r\\n                -- Match by full name OR cleaned name\\r\\n                if tostring(v.Name) == charId or cleanName(v.Name) == cleanedCharId then\\r\\n                    targetRarity = getRarityText(v)\\r\\n                    break\\r\\n                end\\r\\n            end\\r\\n        end\\r\\n    end\\r\\n\\r\\n    -- Rarity Check\\r\\n    local rarityMatch = false\\r\\n    if getgenv().SelectedRarities[\\u0027All\\u0027] then\\r\\n        rarityMatch = true\\r\\n    elseif targetRarity then\\r\\n        for selRarity, enabled in pairs(getgenv().SelectedRarities) do\\r\\n            if enabled and string.lower(trim(selRarity)) == string.lower(trim(targetRarity)) then\\r\\n                rarityMatch = true\\r\\n                break\\r\\n            end\\r\\n        end\\r\\n    end\\r\\n\\r\\n    if not rarityMatch then return false end\\r\\n\\r\\n    -- Brainrot Check\\r\\n    local brainrotMatch = false\\r\\n    if getgenv().SelectedBrainrots[\\u0027All\\u0027] then\\r\\n        brainrotMatch = true\\r\\n    else\\r\\n        for selBr, enabled in pairs(getgenv().SelectedBrainrots) do\\r\\n            if enabled and string.lower(trim(selBr)) == string.lower(trim(cleanedCharId)) then\\r\\n                brainrotMatch = true\\r\\n                break\\r\\n            end\\r\\n        end\\r\\n    end\\r\\n    \\r\\n    return brainrotMatch\\r\\nend\\r\\n\\r\\nValue:AddToggle(\\u0027FarmToggle\\u0027, {\\r\\n    Title = \\u0027Auto Take\\u0027,\\r\\n    Default = false,\\r\\n    Callback = function(V)\\r\\n        getgenv().AutoFarmEnabled = V\\r\\n        if V then\\r\\n            task.spawn(function()\\r\\n                while getgenv().AutoFarmEnabled do\\r\\n                    pcall(function()\\r\\n                        if lp.Character and lp.Character:FindFirstChildOfClass(\\u0027Humanoid\\u0027) and lp.Character.Humanoid.Health \\u003e 0 then\\r\\n                            if isHolding() then\\r\\n                                local root = getRoot()\\r\\n                                if root then\\r\\n                                    root.CFrame = CFrame.new(-429, 1330, -325)\\r\\n                                end\\r\\n                                task.wait(0.5)\\r\\n                            else\\r\\n                                local entities = workspace:FindFirstChild(\\u0027SpawnedEntities\\u0027)\\r\\n                                local target = nil\\r\\n                                if entities then\\r\\n                                    for _, ent in ipairs(entities:GetChildren()) do\\r\\n                                        if isTarget(ent) then\\r\\n                                            target = ent\\r\\n                                            break\\r\\n                                        end\\r\\n                                    end\\r\\n                                end\\r\\n\\r\\n                                if target then\\r\\n                                    local root = getRoot()\\r\\n                                    if root then\\r\\n                                        -- Teleport First (stay stuck to it)\\r\\n                                        root.CFrame = target:GetPivot()\\r\\n                                        \\r\\n                                        -- Wait for MeshPart to appear (Robust check)\\r\\n                                        local mesh = target:FindFirstChildOfClass(\\u0027MeshPart\\u0027) or target:FindFirstChildOfClass(\\u0027BasePart\\u0027)\\r\\n                                        local start = os.clock()\\r\\n                                        while not mesh and (os.clock() - start) \\u003c 6 and getgenv().AutoFarmEnabled do\\r\\n                    